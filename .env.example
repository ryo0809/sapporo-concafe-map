# Node.js 24以上を使用。アプリの接続先はwrangler.jsoncのDB binding。
D1_PERSIST_PATH=.wrangler/state
# 別の場所にある旧SQLiteを移行する場合のみ指定。
# D1_SQLITE_SOURCE=data/database/sapporo.sqlite
# SQLiteがない新規環境の初回データ生成に使用。既存管理者は保持します。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# next dev用。本番はwrangler.jsoncでtrue、Workersのローカル用は.dev.varsでfalse。
SESSION_COOKIE_SECURE=false
# お問い合わせはD1に保存。管理画面の受信一覧から確認・返信する。
# ローカル・プレビューは検索エンジンへ登録しない。本番公開時だけtrue。
SITE_INDEXABLE=false

# Server-only Google Geocoding API key for building addresses
GOOGLE_MAPS_GEOCODING_API_KEY=

# Public behavior analytics: enable only in an approved production build.
# Receiver also needs ANALYTICS_ENABLED=true, ANALYTICS and ANALYTICS_RATE_LIMITER bindings.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
